# IRE Resources Semantic Search - Environment Configuration Example
# Copy this file to .env for local development

# =============================================================================
# QDRANT CONFIGURATION
# =============================================================================
QDRANT_HOST=localhost
QDRANT_PORT=6333
COLLECTION_NAME=nonprofit_knowledge
# The API reads through this alias. Do not point frontend code at a physical
# collection name; a successful publication moves this alias instead.
SERVING_COLLECTION_ALIAS=nonprofit_knowledge_live
VECTOR_SIZE=384

# =============================================================================
# REDIS CONFIGURATION (for SSO session storage)
# =============================================================================
# Local development: Use Docker Redis (started via 'make dev-start')
REDIS_URL=redis://localhost:6379

# Production (Fly.io): Use Fly Redis or Upstash
# REDIS_URL=redis://default:YOUR_PASSWORD@your-redis-host.fly.dev:6379

# =============================================================================
# MEMBERSUITE SSO CONFIGURATION
# =============================================================================
# Obtain these credentials from IRE admin
# MS_TENANT_ID=12345
# MS_ASSOCIATION_ID=your-association-guid

# Session configuration
# SESSION_SECRET=generate-a-random-32-character-secret-here
# SESSION_TTL_SECONDS=3600
# SESSION_COOKIE_NAME=ire_session

# URLs
# FRONTEND_URL=http://localhost:5173
# MS_REQUIRE_MEMBERSHIP=true

# =============================================================================
# API CONFIGURATION
# =============================================================================
PORT=8000
LOG_LEVEL=INFO
PYTHONUNBUFFERED=1

# CORS — Additional allowed origins for community frontend deployments.
# Use this when running a frontend on a domain other than archive.ire.org
# (e.g., when deploying ireapps/ire-archive-frontend to your own Vercel project).
# Accepts a JSON array (preferred) or a comma-separated list.
# ADDITIONAL_ALLOWED_ORIGINS='["https://your-frontend.example.com"]'
# ADDITIONAL_ALLOWED_ORIGINS=https://your-frontend.example.com,https://staging.example.com

# =============================================================================
# APPROVED SNAPSHOT PUBLICATION
# =============================================================================
# These private endpoints stay disabled until both different secrets and narrow
# HTTPS path rules are configured. Put values in Fly secrets, not this file.
# PUBLICATION_DISPATCH_SECRET=long-random-shared-secret
# PUBLICATION_CALLBACK_SECRET=different-long-random-shared-secret
# PUBLICATION_STATE_DB=/data/qdrant_storage/publication-state.sqlite3
# PUBLICATION_WORK_DIR=/tmp/ire-publications
# Only allow the exact trusted storage path prefix (must end in /).
# PUBLICATION_SNAPSHOT_URL_PREFIXES=https://storage.example.org/approved-snapshots/
# Callback may be an exact endpoint or a trusted path prefix (ending in /).
# PUBLICATION_CALLBACK_URLS=https://data.example.org/internal/search-publications/status
# PUBLICATION_CALLBACK_URL_PREFIXES=https://data.example.org/internal/search-publications/
# PUBLICATION_SIGNATURE_MAX_AGE_SECONDS=300
# PUBLICATION_MAX_REQUEST_BYTES=16384
# PUBLICATION_MAX_SNAPSHOT_BYTES=2147483648
# PUBLICATION_MAX_UPLOAD_BYTES=8000000

# =============================================================================
# MODEL CONFIGURATION
# =============================================================================
MODEL_NAME=all-MiniLM-L6-v2
MODEL_CACHE_DIR=./models_cache

# =============================================================================
# RATE LIMITING
# =============================================================================
